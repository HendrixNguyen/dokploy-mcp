# Dokploy instance. No trailing "/api" — the client appends it.
# Public Swagger UI is not served by Dokploy; the spec lives in docs/openapi.v0.30.8.json
DOKPLOY_URL=https://dokploy.huyndg.io.vn

# Required. Create under Dokploy dashboard -> Settings -> API Keys.
DOKPLOY_API_KEY=

# stdio (default, for local MCP clients) | http (remote / shared)
TRANSPORT=stdio

# http transport only
PORT=3000
# Bearer token required on POST /mcp when TRANSPORT=http
MCP_HTTP_TOKEN=
# Comma-separated Origin allowlist for DNS-rebinding protection
ALLOWED_ORIGINS=http://localhost:5173

# error | warn | info | debug   (debug logs every request; the API key is never logged)
LOG_LEVEL=info

# Per-request timeout in ms. Log tools use a longer budget.
DOKPLOY_TIMEOUT_MS=30000
